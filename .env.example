# Copy to .env and fill in. `.env` is gitignored and never enters the image.
# Nothing in this application reads a secret from source: config/database.yml
# and config/initializers/devise.rb both read the environment.

# REQUIRED in production. The JWT signing key -- anyone holding it can mint a
# token for any user. Generate with: bin/rails secret
DEVISE_JWT_SECRET_KEY=

# REQUIRED in production. Generate with: bin/rails secret
SECRET_KEY_BASE=

# Database. Either set DATABASE_URL, or the individual variables below.
# DATABASE_URL=postgres://user:password@host:5432/event_management_app_be_production
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=event_management_app_be_development
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Optional.
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=*
RAILS_MAX_THREADS=5
PORT=3000

# docker-compose host-side ports only.
API_HOST_PORT=8690
DATABASE_HOST_PORT=8695
